{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tolerance.example/schemas/dispute-packet-v1.schema.json",
  "title": "Tolerance DisputePacketV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "xLayerChainId",
    "xLayerEscrow",
    "obligationId",
    "agreementHash",
    "policyHash",
    "evidenceRoot",
    "disputePacketHash",
    "decisionRubric",
    "burdenOfProof",
    "disputedRequirements",
    "governingTerms",
    "approvedAmendments",
    "sourceBlocks",
    "deterministicCheckResults",
    "buyerChallengeStatement",
    "supplierResponse"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "caseId": { "$ref": "#/$defs/bytes32" },
    "xLayerChainId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "xLayerEscrow": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "obligationId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "agreementHash": { "$ref": "#/$defs/bytes32" },
    "policyHash": { "$ref": "#/$defs/bytes32" },
    "evidenceRoot": { "$ref": "#/$defs/bytes32" },
    "disputePacketHash": { "$ref": "#/$defs/bytes32" },
    "decisionRubric": { "type": "string", "minLength": 1 },
    "burdenOfProof": { "type": "string", "minLength": 1 },
    "disputedRequirements": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "governingTerms": { "type": "array", "items": { "type": "object" } },
    "approvedAmendments": { "type": "array", "items": { "type": "object" } },
    "sourceBlocks": { "type": "array", "items": { "type": "object" } },
    "deterministicCheckResults": {
      "type": "array",
      "items": { "type": "object" }
    },
    "buyerChallengeStatement": { "type": "string" },
    "supplierResponse": { "type": "string" }
  },
  "$defs": {
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" }
  }
}
