# Required in production; local development defaults to http://localhost:3000.
TOLERANCE_APP_ORIGIN=http://localhost:3000

# Port for the Express API process. The Vite dev server proxies /api and /auth
# here, and the production server serves both the API and the built SPA.
PORT=3001

# Selects defensive configuration rules. Valid values: development, test, production.
TOLERANCE_ENVIRONMENT=development

# Supabase and Prisma values belong only in ignored .env.local.
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Required only when the AI evaluation adapter is enabled; the deterministic
# evidence evaluation runs without it.
TOLERANCE_EVALUATION_MODEL=
XLAYER_RPC_URL=
AUTOMATIC_ATTESTATION_ENABLED=false
TOLERANCE_DISPUTE_PACKET_MAX_BYTES=120000

# GenLayer submission remains a persistent CLI/keychain worker concern; this
# application process must not receive the submitter's private key.
# In production Vercel creates only durable intents. A Railway worker is the
# only process allowed to use the encrypted CLI account.
GENLAYER_SUBMISSION_MODE=local-cli
GENLAYER_SUBMITTER_RUNTIME_DIR=.phase3c2-genlayer-submit
GENLAYER_WORKER_POLL_MS=15000
# Use true only while provisioning/verifying the deployed signer. In normal
# operation the worker processes durable database intents; never enable it on
# Vercel.
GENLAYER_WORKER_SELF_CHECK_ONLY=false
# Railway worker only: a sealed password for the encrypted keystore stored on
# its persistent volume. Never configure this in Vercel.
GENLAYER_KEYSTORE_PASSWORD=
GENLAYER_KEYSTORE_PATH=/var/lib/tolerance-genlayer/keystore/tolerance-studionet-submitter.json

# These are public network endpoints/configuration, not credentials.
GENLAYER_RPC_URL=https://studio.genlayer.com/api
XLAYER_CHAIN_ID=1952
GENLAYER_CHAIN_ID=61999
