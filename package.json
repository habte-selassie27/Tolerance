{
  "name": "tolerance",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24.15.0 <27",
    "pnpm": ">=11.3.0 <12"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n api,web -c blue,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch --conditions=react-server src/api/server.ts",
    "dev:web": "vite",
    "build": "prisma generate && vite build && vite build --config vite.config.server.mts",
    "start": "node dist/server/server.mjs",
    "preview": "pnpm build && pnpm start",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:rc3-mail": "node scripts/run-rc3-public-mail-proof.mjs",
    "build:genlayer-worker": "tsc -p tsconfig.genlayer-worker.json",
    "worker:genlayer": "pnpm build:genlayer-worker && node --conditions=react-server .worker-build/scripts/genlayer-worker.js",
    "worker:genlayer:check": "pnpm worker:genlayer",
    "proof:judge-v2": "pnpm build:genlayer-worker && node --conditions=react-server .worker-build/scripts/create-judge-v2-synthetic-proof.js",
    "test:integration:phase3b1b": "node scripts/run-phase3b1b-integration.mjs",
    "test:integration:phase3b2b-openai": "node scripts/run-phase3b2b-openai-integration.mjs",
    "test:integration:phase3b2c-direct": "node scripts/run-phase3b2c-direct.mjs",
    "test:integration:phase3c1": "node scripts/run-phase3b1b-integration.mjs",
    "test:integration:phase3c2": "node scripts/run-phase3b1b-integration.mjs",
    "test:integration:phase3c2-live": "node scripts/run-phase3c2-live.mjs",
    "test:integration:phase3c23-live": "node scripts/run-phase3c23-live.mjs",
    "test:integration:rc5-evidence-authority": "node scripts/run-rc5-evidence-authority-integration.mjs",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "verify:phase3a": "node scripts/verify-phase3a.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@next/env": "16.3.0",
    "@prisma/client": "6.19.0",
    "@supabase/ssr": "0.8.0",
    "@supabase/supabase-js": "2.95.3",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "genlayer-js": "1.1.8",
    "openai": "^7.4.0",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "7.18.4",
    "server-only": "0.0.1",
    "viem": "2.38.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "concurrently": "10.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "pdf-lib": "^1.17.1",
    "prettier": "3.9.6",
    "prisma": "6.19.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "4.1.10"
  }
}
